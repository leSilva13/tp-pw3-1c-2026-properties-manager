@model ProgramacionWeb3.PropertiesManager.Web.Models.BuildingFormViewModel

@{
    ViewData["Title"] = "Nuevo Consorcio";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Registrar Nuevo Consorcio</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h4 class="mb-3 text-secondary border-bottom pb-2">Datos Generales</h4>

                        <div class="mb-3">
                            <label asp-for="Building.Name" class="form-label">Nombre del Consorcio</label>
                            <input asp-for="Building.Name" class="form-control" placeholder="Ej: Torre San Justo I" required />
                            <span asp-validation-for="Building.Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Building.ExpensesDueDate" class="form-label">Día Vencimiento Expensas</label>
                                <input asp-for="Building.ExpensesDueDate" type="number" min="1" max="31" class="form-control" placeholder="Ej: 10" required />
                                <span asp-validation-for="Building.ExpensesDueDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Building.TotalSurfaceArea" class="form-label">Superficie Total (m²)</label>
                                <input asp-for="Building.TotalSurfaceArea" type="number" step="0.01" class="form-control" placeholder="Ej: 1450.50" required />
                                <span asp-validation-for="Building.TotalSurfaceArea" class="text-danger"></span>
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3 text-secondary border-bottom pb-2">Dirección del Edificio</h4>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Building.Address.Street" class="form-label">Calle</label>
                                <input asp-for="Building.Address.Street" class="form-control" placeholder="Ej: Arieta" required />
                                <span asp-validation-for="Building.Address.Street" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Building.Address.Number" class="form-label">Número</label>
                                <input asp-for="Building.Address.Number" type="number" class="form-control" placeholder="Ej: 2100" required />
                                <span asp-validation-for="Building.Address.Number" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Provincia</label>
                                <select asp-for="SelectedProvinceId" asp-items="Model.Provinces" class="form-select" id="comboProvincia" required>
                                    <option value="">-- Seleccione una Provincia --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Localidad</label>
                                <select asp-for="SelectedLocalityId" asp-items="Model.Localities" class="form-select" id="comboLocalidad" disabled required>
                                    <option value="">-- Seleccione una Localidad --</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar Consorcio</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>