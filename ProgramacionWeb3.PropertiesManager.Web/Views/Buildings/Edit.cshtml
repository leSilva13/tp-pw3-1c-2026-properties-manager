@model ProgramacionWeb3.PropertiesManager.Web.Models.BuildingFormViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var provinces = ViewBag.Provinces as IEnumerable<SelectListItem>;
    var localities = ViewBag.Localities as IEnumerable<SelectListItem>;
    ViewData["Title"] = "Modificar Edificio";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">Modificar Edificio</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="AddressId" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" id="hfLatitud" name="AddressViewModel.Latitude" />
                        <input type="hidden" id="hfLongitud" name="AddressViewModel.Longitude" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h4 class="mb-3 text-secondary border-bottom pb-2">Datos Generales</h4>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpensesDueDate" class="form-label">Día Vencimiento Expensas</label>
                                <input asp-for="ExpensesDueDate" type="number" min="1" max="31" class="form-control" placeholder="Ej: 10" required />
                                <span asp-validation-for="ExpensesDueDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TotalSurfaceArea" class="form-label">Superficie Total (m²)</label>
                                <input asp-for="TotalSurfaceArea" type="number" step="0.01" class="form-control" placeholder="Ej: 1450.50" required />
                                <span asp-validation-for="TotalSurfaceArea" class="text-danger"></span>
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3 text-secondary border-bottom pb-2">Dirección del Edificio</h4>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="AddressViewModel.Street" class="form-label">Calle</label>
                                <input asp-for="AddressViewModel.Street" id="txtCalle" class="form-control" placeholder="Ej: Arieta" required />
                                <span asp-validation-for="AddressViewModel.Street" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="AddressViewModel.Number" class="form-label">Número</label>
                                <input asp-for="AddressViewModel.Number" type="number" id="txtNumero" class="form-control" placeholder="Ej: 2100" required />
                                <span asp-validation-for="AddressViewModel.Number" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Provincia</label>
                                <select asp-for="AddressViewModel.ProvinceId" asp-items="provinces" class="form-select" id="comboProvincia" required>
                                    <option value="">-- Seleccione una Provincia --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Localidad</label>
                                <select asp-for="AddressViewModel.LocalityId" asp-items="localities" class="form-select" id="comboLocalidad" required>
                                    <option value="">-- Seleccione una Localidad --</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning text-dark">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Acciones</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-controller="Units" asp-action="Index" asp-route-buildingId="@Model.Id" class="btn btn-outline-info">Ver Unidades</a>
                    @* La pantalla Ver Expensas (TP 5.17) todavia no esta implementada:
                       el boton queda deshabilitado para no romper. Habilitar cuando exista. *@
                    <a class="btn btn-outline-info disabled" aria-disabled="true" tabindex="-1">Ver Expensas</a>
                    <a asp-controller="Expenses" asp-action="Index" asp-route-buildingId="@Model.Id" class="btn btn-outline-info">Ver Gastos</a>
                    <a asp-controller="Notifications" asp-action="Index" asp-route-buildingId="@Model.Id" class="btn btn-outline-secondary">Ver Notificaciones</a>
                    <hr />
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="¿Está seguro de que desea eliminar este consorcio?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100">Eliminar Consorcio</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/buildings.js"></script>
}
