@page
@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.Entities.Building>

@{
    ViewData["Title"] = "Mis Consorcios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mis Consorcios</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo Consorcio</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Día Vencimiento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No tienes consorcios registrados.</td>
                </tr>
            }
            else
            {
                @foreach (var edificio in Model)
                {
                    <tr>
                        <td>@edificio.Address?.Street @edificio.Address?.Number</td>
                        <td>
                            @if (edificio.Address != null)
                            {
                                <span>
                                    @edificio.Address.Street @edificio.Address.Number,
                                    @(edificio.Address.Locality?.Name ?? ""),
                                    @(edificio.Address.Locality?.Province?.Name ?? "")
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">Sin dirección asignada</span>
                            }
                        </td>
                       
                        <td>
                            <a asp-controller="Units"
                               asp-action="Index"
                               asp-route-buildingId="@edificio.Id"
                               class="btn btn-info btn-sm text-white">
                                <i class="bi bi-eye"></i> Ver unidades
                            </a>

                            <a asp-action="Edit" asp-route-id="@edificio.Id" class="btn btn-warning btn-sm mx-1">Editar</a>
                            <a asp-action="Delete" asp-route-id="@edificio.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>