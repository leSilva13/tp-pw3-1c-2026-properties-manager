@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.Entities.Building>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Mis Consorcios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mis Consorcios</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo Consorcio</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dirección</th>
                <th>Día Vencimiento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @* 1. Validamos que la lista 'Model' en sí misma no sea nula *@
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No tienes consorcios registrados.</td>
                </tr>
            }
            else
            {
                @foreach (var edificio in Model)
                {
                    <tr>
                        @* 2. Validamos el id (si es nulo ponemos un texto por defecto) *@
                        <td>@(edificio?.Id)</td>

                        <td>
                            @* 3. Navegación 100% segura paso a paso para la dirección *@
                            @if (edificio?.Address != null)
                            {
                                <span>
                                    @edificio.Address.Street @edificio.Address.Number, @edificio.Address.Province?.Name
                                    @*@(edificio.Address.Locality?.Name ?? "Sin Localidad"),
                                    @(edificio.Address.Locality?.Province?.Name ?? "Sin Provincia")*@
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Sin dirección registrada</span>
                            }
                        </td>

                        <td>
                            @if (edificio != null)
                            {
                                <a asp-controller="Units"
                                   asp-action="Index"
                                   asp-route-buildingId="@edificio.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Ver unidades
                                </a>

                                <a asp-action="Edit" asp-route-id="@edificio.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-controller="Notifications" asp-action="Index" asp-route-buildingId="@edificio.Id" class="btn btn-secondary btn-sm">
                                    <i class="bi bi-bell"></i> Notificaciones
                                </a>
                                <form asp-action="Delete" asp-route-id="@edificio.Id" method="post" onsubmit="return confirm('¿Está seguro de que desea eliminar este consorcio?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>