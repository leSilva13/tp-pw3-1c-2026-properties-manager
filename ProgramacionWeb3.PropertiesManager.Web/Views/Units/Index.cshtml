@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.DTOs.UnitDto>

<h1>UNIDADES</h1>
<nav>
    <a asp-controller="Buildings" asp-action="Index">
        Mis Consorcios
    </a>

    <span> &gt; </span>

    <span>@ViewBag.BuildingName</span>

    <span> &gt; Unidades</span>
</nav>

@if (Model == null || !Model.Any())
{
    <p>No hay Unidades todavía!</p>
    <p>Creá uno </p>
    <a asp-controller="Units" asp-action="Create" asp-route-id="@ViewBag.BuildingId">Nueva Unidad</a>
} else
{
    <a asp-controller="Units" asp-action="Create" asp-route-id="@ViewBag.BuildingId">Nueva Unidad</a>
    <table id="tablaUnidades" class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Unidad</th>
                <th>Dueño</th>
                <th>Email</th>
                <th>Superficie</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.Floor@unit.ApartmentNumber</td>
                    <td>@unit.OwnerFullName</td>
                    <td>@unit.OwnerEmail</td>
                    <td>@unit.AreaInMeters</td>
                    <td>
                        <a asp-controller="Units" asp-action="Edit" asp-route-id="@unit.Id">Editar</a>
                        <a asp-controller="Units" asp-action="Delete" asp-route-id="@unit.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        new DataTable("#tablaUnidades");
    </script>
}
}

