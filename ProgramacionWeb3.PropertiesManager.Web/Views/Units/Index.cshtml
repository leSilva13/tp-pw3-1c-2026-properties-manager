@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.DTOs.UnitDto>

<div class="container mt-4">
<nav class="mb-3">
    <a asp-controller="Buildings" asp-action="Index">
        Mis Consorcios
    </a>

    <span> &gt; </span>

    <span>@ViewBag.BuildingName</span>

    <span> &gt; Unidades</span>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Unidades</h1>
    <a asp-controller="Units" asp-action="Create" asp-route-buildingId="@ViewBag.BuildingId" class="btn btn-primary">Nueva Unidad</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No hay unidades registradas todavía.</div>
}
else
{
    <table id="tablaUnidades" class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Unidad</th>
                <th>Dueño</th>
                <th>Email</th>
                <th>Superficie</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.Floor@unit.ApartmentNumber</td>
                    <td>@unit.OwnerFullName</td>
                    <td>@unit.OwnerEmail</td>
                    <td>@unit.AreaInMeters</td>
                    <td>
                        <a asp-controller="Units" asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-controller="Units" asp-action="Delete" asp-route-id="@unit.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        new DataTable("#tablaUnidades");
    </script>
}
