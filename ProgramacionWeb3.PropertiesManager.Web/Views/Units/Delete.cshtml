@model ProgramacionWeb3.PropertiesManager.Core.Entities.Unit
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h1>Eliminar Unidad</h1>

<p>¿Seguro que querés eliminar esta unidad?</p>

<div>
    <p><strong>Unidad:</strong> @Model.Floor@Model.ApartmentNumber</p>
    <p><strong>Superficie:</strong> @Model.AreaInMeters</p>

    @if (Model.Owner != null)
    {
        <p><strong>Dueño:</strong> @Model.Owner.FullName</p>
        <p><strong>Email:</strong> @Model.Owner.Email</p>
    }

    @if (Model.Building?.Address != null)
    {
        <p><strong>Consorcio:</strong> @Model.Building.Address.Street @Model.Building.Address.Number</p>
    }
</div>

<form asp-controller="Units" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit">Eliminar</button>

    <a asp-controller="Units" asp-action="Index" asp-route-buildingId="@Model.BuildingId">
        Cancelar
    </a>
</form>