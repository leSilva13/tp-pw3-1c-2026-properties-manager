@model ProgramacionWeb3.PropertiesManager.Web.Models.UnitFormViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h1>Eliminar Unidad</h1>
<nav>
    <a asp-controller="Buildings" asp-action="Index">
        Mis Consorcios
    </a>
    &gt;

    <a asp-controller="Units"
           asp-action="Index"
           asp-route-id="@Model.BuildingId">
        @Model.BuildingName
    </a>
    &gt;

    <span>Eliminar Unidad</span>
</nav>

<p>¿Seguro que querés eliminar esta unidad?</p>

<div>
    <p><strong>Unidad:</strong> @Model.Floor@Model.ApartmentNumber</p>
    <p><strong>Superficie:</strong> @Model.AreaInMeters</p>

    @if (Model.BuildingName != null)
    {
        <p><strong>Consorcio:</strong> @Model.BuildingName</p>
    }
</div>

<form asp-controller="Units" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit">Eliminar</button>

    <a asp-controller="Units" asp-action="Index" asp-route-id="@Model.BuildingId">
        Cancelar
    </a>
</form>