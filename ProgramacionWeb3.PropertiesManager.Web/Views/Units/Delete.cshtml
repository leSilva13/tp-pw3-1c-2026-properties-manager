@model ProgramacionWeb3.PropertiesManager.Web.Models.UnitFormViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
<nav class="mb-3">
    <a asp-controller="Buildings" asp-action="Index">
        Mis Consorcios
    </a>
    &gt;

    <a asp-controller="Units"
           asp-action="Index"
           asp-route-buildingId="@Model.BuildingId">
        @Model.BuildingName
    </a>
    &gt;

    <span>Eliminar Unidad</span>
</nav>

<div class="card border-danger shadow-sm">
<div class="card-body">
<h1 class="card-title">Eliminar Unidad</h1>
<p class="alert alert-warning">¿Seguro que querés eliminar esta unidad?</p>

<div>
    <p><strong>Unidad:</strong> @Model.Floor@Model.ApartmentNumber</p>
    <p><strong>Superficie:</strong> @Model.AreaInMeters</p>

    @if (Model.BuildingName != null)
    {
        <p><strong>Consorcio:</strong> @Model.BuildingName</p>
    }
</div>

<form asp-controller="Units" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Eliminar</button>

    <a asp-controller="Units" asp-action="Index" asp-route-buildingId="@Model.BuildingId" class="btn btn-outline-secondary">
        Cancelar
    </a>
</form>
</div>
</div>
</div>
