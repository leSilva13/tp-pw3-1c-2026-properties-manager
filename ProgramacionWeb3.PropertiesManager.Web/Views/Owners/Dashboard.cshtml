@model ProgramacionWeb3.PropertiesManager.Web.Models.Owner.OwnerDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="mb-0 text-primary">Mis Propiedades</h2>
            <p class="text-muted">Resumen de tus unidades.</p>
        </div>
        <a href="/Buildings/Mapa" class="btn btn-outline-secondary">
            <i class="bi bi-map"></i> Ver en Mapa
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var building in Model.BuildingViewModels)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-dark text-white py-3">
                        <h5 class="card-title mb-1">
                            <i class="bi bi-building me-2"></i>@building.FullAddress
                        </h5>
                    </div>

                    <div class="card-body p-0">
                        <div class="bg-light px-3 py-2 border-bottom fw-bold text-secondary">
                            Mis Unidades
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var unit in building.UnitViewModels)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Unidad @unit.Floor @unit.ApartmentNumber</span>
                                    @if (building.MultipurposeRoomViewModels.Any())
                                    {
                                        <a href="/MultipurposeRoomReservations/Create?unitId=@unit.Id&buildingId=@building.Id" class="btn btn-sm btn-primary text-start">
                                            <i class="bi bi-calendar-plus me-2"></i>Reservar SUM
                                        </a>
                                    }

                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mt-3">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <div>
                <h2 class="mb-0 text-primary">Mis Reservas</h2>
                <p class="text-muted">Resumen de tus reservas de espacios comunes disponibles.</p>
            </div>
        </div>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Turno</th>
                    <th>Comentarios</th>
                    <th>SUM</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.MultipurposeRoomReservationViewModels.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No existen reservas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var reservation in Model.MultipurposeRoomReservationViewModels)
                    {
                        <tr>
                            <td>@reservation.ReservationDate.ToShortDateString()</td>
                            <td>
                                @reservation.Shift
                            </td>
                            <td>
                                @reservation.Comments
                            </td>
                            <td>
                                @reservation.MultipurposeRoomViewModel.Name
                            </td>

                            <td>
                                <a href="/MultipurposeRoomReservations/Edit?multipurposeRoomReservationId=@reservation.Id" class="btn btn-sm btn-warning text-start">
                                    <i class="bi bi-pencil me-2"></i>Editar
                                </a>
                                @if (reservation.ReservationDate > DateOnly.FromDateTime(DateTime.Today))
                                {
                                    <form asp-action="Delete" asp-controller="MultipurposeRoomReservations" asp-route-multipurposeRoomReservationId="@reservation.Id" method="post" class="d-inline" data-confirm="¿Está seguro de que desea dar de baja la reserva?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Dar de Baja
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>