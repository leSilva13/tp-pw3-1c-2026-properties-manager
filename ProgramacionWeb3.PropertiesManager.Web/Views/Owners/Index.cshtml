@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ProgramacionWeb3.PropertiesManager.Web.Models.OwnerFormViewModel>


<h1>OWNERS</h1>

@if (Model == null || !Model.Any())
{
    <p>No hay owners todavía!</p>
    <p>Creá uno </p>
    <a asp-action="crear">Agregar Owner</a>
}
else
{
    <a asp-controller="Owners" asp-action="Crear">Agregar Owner</a>

    <table id="tablaUnidades" class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre completo</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owner in Model)
            {
                <tr>
                    <td>@owner.Id</td>
                    <td>@owner.FullName</td>
                    <td>@owner.Email</td>
                    <td>
                        <a asp-controller="Owners" asp-action="Editar" asp-route-id="@owner.Id">Editar</a>
                        <a asp-controller="Owners" asp-action="Eliminar" asp-route-id="@owner.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        new DataTable("#tablaUnidades");
    </script>
}
}