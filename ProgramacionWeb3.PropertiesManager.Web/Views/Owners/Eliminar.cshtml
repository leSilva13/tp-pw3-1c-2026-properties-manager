@model ProgramacionWeb3.PropertiesManager.Web.Models.OwnerFormViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <h1 class="mb-3">Eliminar Owner</h1>

    <div class="card card-body shadow-sm">
        <p>¿Seguro que querés eliminar este owner?</p>
        <p><strong>Nombre:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>

        <form asp-controller="Owners" asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-controller="Owners" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
