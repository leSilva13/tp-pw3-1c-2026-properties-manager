@using ProgramacionWeb3.PropertiesManager.Core.Common.Enums
@using ProgramacionWeb3.PropertiesManager.Web.Models
@model MultipurposeRoomReservationViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Nueva Reserva de SUM";
    var multipurposeRooms = ViewBag.MultipurposeRooms as IEnumerable<SelectListItem>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Owners/Dashboard">Mi Panel</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reservar SUM</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-calendar-check me-2"></i>Nueva Reserva
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="UnitId" />
                        <input type="hidden" asp-for="BuildingId" />

                        <div class="mb-3">
                            <label asp-for="MultipurposeRoomId" class="form-label fw-bold">SUM que reserva</label>
                            <select asp-for="MultipurposeRoomId" asp-items="multipurposeRooms" class="form-select" required>
                                <option value="">-- Seleccione el SUM --</option>
                            </select>
                            <span asp-validation-for="MultipurposeRoomId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ReservationDate" class="form-label fw-bold">Fecha</label>
                                <input asp-for="ReservationDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Shift" class="form-label fw-bold">Turno</label>
                                <select asp-for="Shift" asp-items="Html.GetEnumSelectList<MultipurposeRoomShiftEnum>()" class="form-select" required>
                                    <option value="">-- Seleccione Turno --</option>
                                </select>
                                <span asp-validation-for="Shift" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Comments" class="form-label fw-bold">Comentarios / Notas adicionales</label>
                            <textarea asp-for="Comments" class="form-control" rows="3" placeholder="Ej. Cantidad de invitados aproximada, si se requiere uso de parrilla, etc."></textarea>
                            <span asp-validation-for="Comments" class="text-danger small"></span>
                        </div>

                        <input type="hidden" asp-for="WasWellDelivered" value="false" />

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/Owners/Dashboard" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Confirmar Reserva</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}