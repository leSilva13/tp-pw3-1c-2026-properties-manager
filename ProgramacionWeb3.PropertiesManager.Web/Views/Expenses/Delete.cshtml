@model ProgramacionWeb3.PropertiesManager.Web.Models.ExpenseDeleteViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Eliminar Gasto";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Buildings" asp-action="Index">Mis Consorcios</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-buildingId="@Model.Expense.BuildingId">@Model.BuildingLabel - Gastos</a></li>
            <li class="breadcrumb-item active">Eliminar Gasto</li>
        </ol>
    </nav>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">Confirmar Eliminación</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">¿Estás seguro que querés eliminar este gasto?</p>

                    <dl class="row">
                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">@Model.Expense.Description</dd>

                        <dt class="col-sm-4">Monto</dt>
                        <dd class="col-sm-8">$@Model.Expense.Amount.ToString("N2")</dd>

                        <dt class="col-sm-4">Período</dt>
                        <dd class="col-sm-8">@Model.Expense.ExpenseMonth/@Model.Expense.ExpenseYear</dd>

                        <dt class="col-sm-4">Tipo</dt>
                        <dd class="col-sm-8">@(Model.Expense.ExpenseTypeName ?? "-")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Expense.Id" />
                        <div class="d-flex justify-content-end mt-3">
                            <a asp-action="Index" asp-route-buildingId="@Model.Expense.BuildingId" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
