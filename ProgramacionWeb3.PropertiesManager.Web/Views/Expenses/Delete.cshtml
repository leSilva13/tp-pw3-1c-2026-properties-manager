@model ProgramacionWeb3.PropertiesManager.Core.Entities.Expense
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Eliminar Gasto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">Confirmar Eliminación</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">¿Estás seguro que querés eliminar este gasto?</p>

                    <dl class="row">
                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Monto</dt>
                        <dd class="col-sm-8">$@Model.Amount.ToString("N2")</dd>

                        <dt class="col-sm-4">Período</dt>
                        <dd class="col-sm-8">@Model.ExpenseMonth/@Model.ExpenseYear</dd>

                        <dt class="col-sm-4">Tipo</dt>
                        <dd class="col-sm-8">@(Model.ExpenseType?.Name ?? "-")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end mt-3">
                            <a asp-action="Index" asp-route-buildingId="@Model.BuildingId" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
