@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.Entities.Expense>

@{
    ViewData["Title"] = "Gastos del Edificio";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Gastos del Edificio</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo Gasto</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Monto</th>
                <th>Tipo</th>
                <th>Período</th>
                <th>Global</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay gastos registrados para este edificio.</td>
                </tr>
            }
            else
            {
                @foreach (var gasto in Model)
                {
                    <tr>
                        <td>@gasto.Description</td>
                        <td>$@gasto.Amount.ToString("N2")</td>
                        <td>@(gasto.ExpenseType?.Name ?? "-")</td>
                        <td>@gasto.ExpenseMonth/@gasto.ExpenseYear</td>
                        <td>
                            @if (gasto.IsGlobal)
                            {
                                <span class="badge bg-success">Global</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Específico</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@gasto.Id" class="btn btn-warning btn-sm mx-1">Editar</a>
                            <a asp-action="Delete" asp-route-id="@gasto.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
