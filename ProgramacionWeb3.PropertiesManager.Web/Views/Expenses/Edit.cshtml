@model ProgramacionWeb3.PropertiesManager.Web.Models.ExpenseFormViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Editar Gasto";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Buildings" asp-action="Index">Mis Consorcios</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-buildingId="@Model.SelectedBuildingId">@Model.BuildingLabel - Gastos</a></li>
            <li class="breadcrumb-item active">Editar Gasto</li>
        </ol>
    </nav>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">Editar Gasto</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ReceiptPath" type="hidden" />
                        <input asp-for="SelectedBuildingId" type="hidden" />

                        <h4 class="mb-3 text-secondary border-bottom pb-2">Datos del Gasto</h4>

                        <div class="mb-3">
                            <label class="form-label">Consorcio</label>
                            <input type="text" class="form-control" value="@Model.BuildingLabel" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tipo de Gasto</label>
                            <select asp-for="SelectedExpenseTypeId" asp-items="Model.ExpenseTypes" class="form-select">
                                <option value="">-- Seleccione un tipo --</option>
                            </select>
                            <span asp-validation-for="SelectedExpenseTypeId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <input asp-for="Description" class="form-control" required />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label">Monto ($)</label>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BillingDate" class="form-label">Fecha de Facturación</label>
                                <input asp-for="BillingDate" type="date" class="form-control" required />
                                <span asp-validation-for="BillingDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpenseYear" class="form-label">Año Expensa</label>
                                <input asp-for="ExpenseYear" type="number" min="2000" class="form-control" required />
                                <span asp-validation-for="ExpenseYear" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpenseMonth" class="form-label">Mes Expensa</label>
                                <input asp-for="ExpenseMonth" type="number" min="1" max="12" class="form-control" required />
                                <span asp-validation-for="ExpenseMonth" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsGlobal" class="form-check-input" type="checkbox" id="chkIsGlobal" />
                                <label asp-for="IsGlobal" class="form-check-label">
                                    Gasto Global (aplica a todas las unidades)
                                </label>
                            </div>
                        </div>

                        <div id="divUnidades" class="mb-3 @(Model.IsGlobal ? "d-none" : "")">
                            <label class="form-label">Unidades que aplica</label>
                            <div id="listaUnidades" class="border rounded p-2">
                                @if (Model.AvailableUnits != null && Model.AvailableUnits.Any())
                                {
                                    @foreach (var unidad in Model.AvailableUnits)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedUnitIds" value="@unidad.Id"
                                                   id="unit_@unidad.Id"
                                                   @(Model.SelectedUnitIds.Contains(unidad.Id) ? "checked" : "") />
                                            <label class="form-check-label" for="unit_@unidad.Id">
                                                Piso @unidad.Floor - Depto @unidad.ApartmentNumber
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Este consorcio no tiene unidades.</span>
                                }
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3 text-secondary border-bottom pb-2">Comprobante</h4>

                        @if (!string.IsNullOrEmpty(Model.ReceiptPath))
                        {
                            <div class="mb-2">
                                <span class="text-muted">Comprobante actual: </span>
                                <a asp-action="DescargarComprobante" asp-route-id="@Model.Id">Descargar comprobante</a>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Reemplazar comprobante (opcional) <small class="text-muted">(PDF, JPG o PNG · máx. 5 MB)</small></label>
                            <input type="file" name="receiptFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Eliminar Gasto</a>
                            <div class="d-flex gap-2">
                                <a asp-action="Index" asp-route-buildingId="@Model.SelectedBuildingId" class="btn btn-outline-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/expenses-form.js"></script>
}
