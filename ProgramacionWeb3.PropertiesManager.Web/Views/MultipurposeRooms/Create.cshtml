@model ProgramacionWeb3.PropertiesManager.Web.Models.MultipurposeRoomViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Nuevo SUM";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Registrar Nuevo SUM</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input asp-for="BuildingId" class="form-control" type="hidden" required />

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Name" class="form-label">Nombre</label>
                                <input asp-for="Name" class="form-control" type="text" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="Floor" class="form-label">Piso</label>
                                <input asp-for="Floor" class="form-control" type="text" required />
                                <span asp-validation-for="Floor" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" asp-route-buildingId="@Model.BuildingId" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>