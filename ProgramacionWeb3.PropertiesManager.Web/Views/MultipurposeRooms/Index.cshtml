@model IEnumerable<ProgramacionWeb3.PropertiesManager.Web.Models.MultipurposeRoomViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "SUMs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>SUMs</h1>
        <a asp-action="Create" class="btn btn-primary"
           asp-route-buildingId="@ViewBag.buildingId">Nuevo SUM</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Piso</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No existen SUMs.</td>
                </tr>
            }
            else
            {
                @foreach (var multipurposeRoom in Model)
                {
                    <tr>
                        <td>@multipurposeRoom.Name</td>
                        <td>
                            @multipurposeRoom.Floor
                        </td>
                        <td>
                            @multipurposeRoom.IsActive
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-multipurposeRoomId="@multipurposeRoom.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>