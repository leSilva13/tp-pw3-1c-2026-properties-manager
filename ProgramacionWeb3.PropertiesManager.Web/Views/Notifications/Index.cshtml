@model IEnumerable<ProgramacionWeb3.PropertiesManager.Core.Entities.Notificacion>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Notificaciones del Consorcio";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Buildings" asp-action="Index">Mis Consorcios</a></li>
            <li class="breadcrumb-item text-muted">@ViewBag.BuildingAddress</li>
            <li class="breadcrumb-item active" aria-current="page">Notificaciones</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Notificaciones</h1>
        <a asp-action="Create" asp-route-buildingId="@ViewBag.BuildingId" class="btn btn-primary">Crear Notificación</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Título</th>
                <th>Descripción</th>
                <th>Fecha Creación</th>
                <th>Fecha Envío</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No hay notificaciones para este consorcio.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @* Título clickeable: Edita si no se envió, ve detalle si se envió *@
                            @if (item.SendDate == null)
                            {
                                <a asp-action="Edit" asp-route-id="@item.IdNotificacion" class="fw-bold text-decoration-none">@item.Title</a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.IdNotificacion" class="fw-bold text-decoration-none text-success">@item.Title</a>
                            }
                        </td>
                        <td>
                            @* Descripción acortada con "..." *@
                            @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 40)
                            {
                                <span title="@item.Description">@(item.Description.Substring(0, 40))...</span>
                            }
                            else
                            {
                                <span>@item.Description</span>
                            }
                        </td>
                        <td>@item.CreationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.SendDate.HasValue)
                            {
                                <span class="badge bg-success">Enviado el @item.SendDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pendiente</span>
                            }
                        </td>
                        <td>
                            @if (item.SendDate == null)
                            {
                                <form asp-action="Send" method="post" class="d-inline" data-confirm="¿Está seguro de enviar esta notificación a todos los propietarios? Esta acción no se puede deshacer.">
                                    <input type="hidden" name="id" value="@item.IdNotificacion" />
                                    <input type="hidden" name="buildingId" value="@item.IdBuilding" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-send"></i> Enviar
                                    </button>
                                </form>

                                <form asp-action="Delete" method="post" class="d-inline" data-confirm="¿Está seguro de que desea eliminar esta notificación?">
                                    <input type="hidden" name="id" value="@item.IdNotificacion" />
                                    <input type="hidden" name="buildingId" value="@item.IdBuilding" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>