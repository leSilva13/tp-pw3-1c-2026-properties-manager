@model IEnumerable<ProgramacionWeb3.PropertiesManager.Web.Models.UserViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Usuarios</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Activo</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No existen usuarios.</td>
                </tr>
            }
            else
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            @if (user.IsActive)
                                    {
                                    <i class="bi bi-check-circle-fill text-success" title="Activo"></i>
                                    }
                                    else
                                     {
                                      <i class="bi bi-x-circle-fill text-danger" title="Inactivo"></i>
                                     }
                        </td>
                        <td>
                            @user.RoleName
                        </td>

                        <td>
                            @if (user.IsActive)
                              {
                               <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" data-confirm="¿Está seguro de que desea dar de baja al usuario?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Dar de Baja
                                </button>
                                </form>
                                }
                             else
                                {
                                <form asp-action="Activate" asp-route-id="@user.Id" method="post" class="d-inline" data-confirm="¿Está seguro de que desea activar al usuario?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">
                                <i class="bi bi-check-circle"></i> Activar
                                </button>
                                </form>
                                }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>