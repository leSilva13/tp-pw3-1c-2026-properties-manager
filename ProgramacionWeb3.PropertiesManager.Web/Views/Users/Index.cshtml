@model IEnumerable<ProgramacionWeb3.PropertiesManager.Web.Models.UserViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Usuarios</h1>
        <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Activo</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No existen usuarios.</td>
                </tr>
            }
            else
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            @user.IsActive
                        </td>
                        <td>
                            @user.RoleName
                        </td>

                        <td>

                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('¿Está seguro de que desea dar de baja al usuario?');" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Dar de Baja
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>